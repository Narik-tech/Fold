[gd_resource type="Resource" script_class="FoldLevel" load_steps=16 format=3]

[ext_resource type="Script" path="res://levels/level_definition.gd" id="1_level"]
[ext_resource type="Script" path="res://levels/shape_definition.gd" id="2_shape"]

