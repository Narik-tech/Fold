[resource]
script = ExtResource("1_level")
title = "Shape sample / Tesseract"
subtitle = "A cube with another direction."
lesson = "Walk through an open tesseract frame. Fold from its near cube into W to inspect its connecting edges."
hints = Array[String](["At X -6, hold E to 90 degrees, release, and walk to W +1.5 to pass around the low beam. Then walk along X to the center echo.", "At X 0, walk back to W 0 for the other echo, then return to W +1.5. The frame has an open interior.", "Keep W +1.5 as you walk to X +6, then return to W 0 for the amber gate."])
start = Vector4(-6, 0, 0.65, 0)
goal = Vector4(6, 0, 0.65, 0)
goal_hint = "Collect both center echoes. Cross the frame at W +1.5, then return to W 0 at X +6."
boxes = Array[ExtResource("2_box")]([SubResource("Resource_b2xf3")])
shapes = Array[ExtResource("3_shape")]([SubResource("Resource_kym0o")])
seeds = Array[Vector4]([Vector4(0, 0.85, 0.65, 0), Vector4(0, 0.85, 0.65, 1.5)])
solution = Array[Vector4]([Vector4(-6, 0, 0.65, 0), Vector4(-6, 0, 0.65, 1.5), Vector4(0, 0, 0.65, 1.5), Vector4(0, 0, 0.65, 0), Vector4(0, 0, 0.65, 1.5), Vector4(6, 0, 0.65, 1.5), Vector4(6, 0, 0.65, 0)])
