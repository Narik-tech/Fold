[resource]
script = ExtResource("1_level")
title = "04  /  The fourfold labyrinth"
subtitle = "Two depths below. A way home above."
lesson = "Explore the teal courts in Z and W. Find five echoes, then climb home. Each echo saves a checkpoint; H gives guidance."
hints = Array[String](["Lantern: follow Z from the entrance to the teal court (Z 0). Fold to W +5, then return along Z to -5.", "Orchard: from Lantern, return to Z 0 and cross X to the crossroads. At X 0, go to Z -5, then X +5.", "Heart: from Orchard, fold back to W 0. Walk to X 0, then follow Z to the central room at Z 0.", "Stillwater: from Heart, follow Z to +5, then X to -5. Fold into W +5 to discover the quiet alcove.", "Sky: leave Stillwater along X to +5. Fold to W 0, return to Z 0, and climb the pale steps outside the east wall. Follow the sky walk through W +5, X +5, then Z -5."])
start = Vector4(-5.0, 0.0, -5.0, 0.0)
goal = Vector4(-5.0, 4.8, -5.0, 5.0)
goal_hint = "From Sky at (X +5, Z -5, W +5), follow the raised bridge toward negative X. Jump the two final steps to the amber gate."
boxes = Array[ExtResource("2_box")]([SubResource("Foundation"), SubResource("Wall_A00_A10"), SubResource("Wall_A00_B00"), SubResource("Wall_A01_A02"), SubResource("Wall_A10_B10"), SubResource("Wall_A11_A21"), SubResource("Wall_A11_B11"), SubResource("Wall_A12_A22"), SubResource("Wall_A20_A21"), SubResource("Wall_A21_B21"), SubResource("Wall_B00_B10"), SubResource("Wall_B01_B02"), SubResource("Wall_B11_B12"), SubResource("Wall_B20_B21"), SubResource("Wall_B21_B22"), SubResource("WestBoundary"), SubResource("NorthBoundary"), SubResource("SouthBoundary"), SubResource("NearBoundary"), SubResource("FarBoundary"), SubResource("EastBoundary_00"), SubResource("EastBoundary_02"), SubResource("EastBoundary_10"), SubResource("EastBoundary_11"), SubResource("EastBoundary_12"), SubResource("StairGarden"), SubResource("Ascent_0"), SubResource("Ascent_1"), SubResource("Ascent_2"), SubResource("Ascent_3"), SubResource("SkyFold"), SubResource("SkyEast"), SubResource("SkyNorth"), SubResource("SkyHome"), SubResource("HomeStep"), SubResource("GateTerrace")])
