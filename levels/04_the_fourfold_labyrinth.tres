[resource]
script = ExtResource("1_level")
title = "04  /  The fourfold labyrinth"
subtitle = "Two depths below. A way home above."
lesson = "Explore the teal courts in Z and W. Find five echoes, then climb home. Each echo saves a checkpoint; H gives guidance."
hints = Array[String](["Lantern: follow Z from the entrance to the teal court (Z 0). Fold to W +5, then return along Z to -5.", "Orchard: from Lantern, return to Z 0 and cross X to the crossroads. At X 0, go to Z -5, then X +5.", "Heart: from Orchard, fold back to W 0. Walk to X 0, then follow Z to the central room at Z 0.", "Stillwater: from Heart, follow Z to +5, then X to -5. Fold into W +5 to discover the quiet alcove.", "Sky: leave Stillwater along X to +5. Fold to W 0, return to Z 0, and climb the pale steps outside the east wall. Follow the sky walk through W +5, X +5, then Z -5."])
start = Vector4(-5, 0, -5, 0)
goal = Vector4(-5, 4.8, -5, 5)
goal_hint = "From Sky at (X +5, Z -5, W +5), follow the raised bridge toward negative X. Jump the two final steps to the amber gate."
boxes = Array[ExtResource("2_box")]([SubResource("Resource_53uth"), SubResource("Resource_46kgw"), SubResource("Resource_wvsww"), SubResource("Resource_wjl2v"), SubResource("Resource_42ayk"), SubResource("Resource_q48jp"), SubResource("Resource_6v8qb"), SubResource("Resource_w6g5f"), SubResource("Resource_odyap"), SubResource("Resource_m0087"), SubResource("Resource_he6p0"), SubResource("Resource_f3n34"), SubResource("Resource_t3r5e"), SubResource("Resource_u2dcu"), SubResource("Resource_87wy5"), SubResource("Resource_pycio"), SubResource("Resource_ehyon"), SubResource("Resource_3l155"), SubResource("Resource_0f5yq"), SubResource("Resource_p68l2"), SubResource("Resource_a4e6w"), SubResource("Resource_12f5k"), SubResource("Resource_wcatj"), SubResource("Resource_27wfd"), SubResource("Resource_r3b8i"), SubResource("Resource_n4lys"), SubResource("Resource_jp81k"), SubResource("Resource_uxo3c"), SubResource("Resource_jp38v"), SubResource("Resource_w3vhu"), SubResource("Resource_s0ol3"), SubResource("Resource_omjmn"), SubResource("Resource_py4vb"), SubResource("Resource_8hyor"), SubResource("Resource_l6dcw"), SubResource("Resource_sswwg")])
seeds = Array[Vector4]([Vector4(-5, 0.85, -5, 5), Vector4(5, 0.85, -5, 5), Vector4(0, 0.85, 0, 0), Vector4(-5, 0.85, 5, 5), Vector4(5, 4.05, -5, 5)])
echo_names = Array[String](["Lantern", "Orchard", "Heart", "Stillwater", "Sky"])
echo_checkpoints = Array[Vector4]([Vector4(-5, 0, -5, 5), Vector4(5, 0, -5, 5), Vector4(0, 0, 0, 0), Vector4(-5, 0, 5, 5), Vector4(5, 3.2, -5, 5)])
waymark_positions = Array[Vector4]([Vector4(-5, 0, -5.8, 0), Vector4(-5, 0, 0, 0), Vector4(-5, 0, -5.8, 5), Vector4(0, 0, 0, 5), Vector4(5, 0, -5.8, 5), Vector4(0, 0, -0.7, 0), Vector4(-5, 0, 5, 0), Vector4(-5, 0, 5.8, 5), Vector4(5, 0, 0, 0), Vector4(11.2, 3.2, 0, 0), Vector4(5, 3.2, -5.8, 5), Vector4(-5, 4.8, -5.8, 5)])
waymark_labels = Array[String](["THE FOURFOLD LABYRINTH
Five echoes. One way home.", "FOLDING COURT
Hold E to explore W", "01 / LANTERN", "THE CROSSROADS
Explore both depths", "02 / ORCHARD
A way back through W", "03 / HEART", "QUIET ALCOVE
A room beyond this slice", "04 / STILLWATER", "THE ASCENT
Space to climb", "SKY WALK
Follow W +5", "05 / SKY ECHO", "HOME"])
